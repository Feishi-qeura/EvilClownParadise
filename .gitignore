# 忽略项目根目录全部内容，下方白名单内的路径才入库
/*

# Unreal 项目文件与源资源
!/.gitignore
!/.gitattributes
!/.clang-format
!/.editorconfig
!/.gitignore
!/EvilClownParadise.uproject
!/README.md
!/Source/
!/Content/
!/Config/
!/Plugins/
!/docs/

# Unreal 自动生成的构建产物，一律不入库
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/.vs/
**/.idea/

# IDE 个人设置不入库（Rider 会自动重装 RiderLink，无需提交）
.RiderSetting/
Plugins/Developer/

# 商店插件不入库（授权限制再分发；团队各自从 Marketplace 安装）
Plugins/Marketplace/

# 学习/演示素材不入库（完整副本在 E:\UnrealProjects\ECP_Archive\Content_zxx）。
# 仅保留 ABP_ECPCommon 依赖的骨架文件，待编辑器内迁移到 _Game 后可彻底移除
Content/zxx/*
!Content/zxx/Character/
Content/zxx/Character/*
!Content/zxx/Character/PolygonSyntyCharacter_Skeleton.uasset

# 插件演示内容不入库（副本在 E:\UnrealProjects\ECP_Archive\FUOnlineSession_Content）；
# 会话插件只需 Source 与 Config 即可工作
Plugins/FUOnlineSession/Content/

# 个人沙盒与本地集合（Developers 目录按 UE 官方约定仅本机使用，不提交）
Content/Developers/
Content/Collections/
