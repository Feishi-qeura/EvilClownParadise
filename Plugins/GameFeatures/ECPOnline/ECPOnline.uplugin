{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0.0",
  "FriendlyName": "ECP Online",
  "Description": "Project online feature entry points backed by the existing FUOnlineSession providers.",
  "Category": "Game Features",
  "CanContainContent": true,
  "ExplicitlyLoaded": true,
  "BuiltInInitialFeatureState": "Active",
  "SupportedTargetPlatforms": [
    "Win64"
  ],
  "Modules": [
    {
      "Name": "ECPOnline",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Win64"
      ],
      "PlatformArchitectureDenyList": [
        "Win64:arm64"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "ECPFoundation",
      "Enabled": true
    },
    {
      "Name": "FUOnlineSession",
      "Enabled": true
    },
    {
      "Name": "GameFeatures",
      "Enabled": true
    }
  ],
  "EnabledByDefault": false
}
